# Only the Project/ folder goes into the image
*
!Project/
!Project/**

# Secrets - pass these at runtime with --env-file instead
Project/.env
Project/.streamlit/secrets.toml

# Generated by the run_*.py scripts during the image build
Project/processed/
Project/output/
Project/database/

# Caches
**/__pycache__/
**/*.pyc
Project/.pytest_cache/
